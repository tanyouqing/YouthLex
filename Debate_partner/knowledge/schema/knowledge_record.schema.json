{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://debate-partner.local/schemas/knowledge_record.schema.json",
  "title": "Debate Knowledge Record Schema",
  "type": "object",
  "required": [
    "record_id",
    "record_type",
    "schema_version",
    "jurisdiction",
    "scenario_tags",
    "keywords",
    "quality_level",
    "source",
    "updated_at",
    "content"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 6
    },
    "record_type": {
      "type": "string",
      "enum": [
        "statute",
        "case",
        "issue_rule",
        "rebuttal_template"
      ]
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "jurisdiction": {
      "type": "string",
      "description": "默认 CN-ML（中国大陆）"
    },
    "scenario_tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "quality_level": {
      "type": "string",
      "enum": [
        "demo",
        "reviewed",
        "production"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "source_type",
        "citation",
        "reliability"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "law",
            "judicial_interpretation",
            "guideline",
            "mock_case",
            "mixed"
          ]
        },
        "citation": {
          "type": "string",
          "minLength": 3
        },
        "reliability": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "content": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "statute"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/statute_content"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "case"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/case_content"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "issue_rule"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/issue_rule_content"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "rebuttal_template"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/rebuttal_template_content"
          }
        }
      }
    }
  ],
  "$defs": {
    "statute_content": {
      "type": "object",
      "required": [
        "law_name",
        "article_no",
        "raw_text",
        "plain_explanation",
        "applicable_scenarios",
        "elements_of_application",
        "common_counterpoints",
        "linked_issues"
      ],
      "properties": {
        "law_name": {
          "type": "string"
        },
        "article_no": {
          "type": "string"
        },
        "raw_text": {
          "type": "string"
        },
        "plain_explanation": {
          "type": "string"
        },
        "applicable_scenarios": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "elements_of_application": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "common_counterpoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "linked_issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "case_content": {
      "type": "object",
      "required": [
        "case_title",
        "case_type",
        "is_mock_case",
        "facts_summary",
        "disputed_issues",
        "court_reasoning",
        "judgment_result",
        "usable_points_for_plaintiff",
        "usable_points_for_defendant",
        "evidence_focus",
        "linked_statutes"
      ],
      "properties": {
        "case_title": {
          "type": "string"
        },
        "case_type": {
          "type": "string"
        },
        "is_mock_case": {
          "type": "boolean"
        },
        "facts_summary": {
          "type": "string"
        },
        "disputed_issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "court_reasoning": {
          "type": "string"
        },
        "judgment_result": {
          "type": "string"
        },
        "usable_points_for_plaintiff": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "usable_points_for_defendant": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_focus": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "linked_statutes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "issue_rule_content": {
      "type": "object",
      "required": [
        "issue_name",
        "case_type",
        "issue_definition",
        "typical_plaintiff_claims",
        "typical_defendant_claims",
        "required_evidence_for_plaintiff",
        "required_evidence_for_defendant",
        "common_attack_paths",
        "linked_statutes",
        "linked_cases"
      ],
      "properties": {
        "issue_name": {
          "type": "string"
        },
        "case_type": {
          "type": "string"
        },
        "issue_definition": {
          "type": "string"
        },
        "typical_plaintiff_claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "typical_defendant_claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_evidence_for_plaintiff": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_evidence_for_defendant": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "common_attack_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "linked_statutes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "linked_cases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "rebuttal_template_content": {
      "type": "object",
      "required": [
        "template_type",
        "applicable_when",
        "template_text",
        "followup_questions",
        "linked_issue_rules",
        "linked_statutes"
      ],
      "properties": {
        "template_type": {
          "type": "string"
        },
        "applicable_when": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "template_text": {
          "type": "string"
        },
        "followup_questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "linked_issue_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "linked_statutes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tone": {
          "type": "string",
          "enum": [
            "formal",
            "strict",
            "neutral"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
